---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Projeto MicroGravidade',
    subtitle: 'Agência Espacial Brasileira — AEB',
    description: 'Projeto em parceria com a AEB — lançamento do foguete VSB-30, relatório de pesquisa e resultado final.',
    image: '/img/projeto-microgravidade.jpg',
    links: [
      {
        label: 'Lançamento (INPE)',
        href: 'https://www.gov.br/inpe/pt-br/assuntos/ultimas-noticias/sucesso-no-lancamento-do-foguete-vsb-30-com-experimento-do-inpe',
      },
      {
        label: 'Relatório Pesquisa 2023',
        href: '/docs/relatorio-santa-branca.pdf',
      },
      {
        label: 'Resultado Final (AEB)',
        href: 'https://www.gov.br/aeb/pt-br/media/resultado-final-microgravidade.pdf/view',
      },
    ],
  },
  {
    title: 'Projetos Educação',
    subtitle: 'SEDF',
    description: 'Educação Profissionalizante para PNE e Qualificação de Professores da rede pública do DF.',
    image: '/img/projeto-educacao.jpg',
  },
  {
    title: 'Distribuição de Alimentos',
    subtitle: 'Ação social',
    description: 'Doação de Gêneros Alimentícios para famílias carentes — Cestas Básicas, Pão e Leite.',
    image: '/img/projeto-alimentos.jpg',
  },
  {
    title: 'Doação de Produtos Apreendidos',
    subtitle: 'Receita Federal · Polícia Federal',
    description: 'Através de solicitações à Receita Federal e à Polícia Federal, recebemos doações de produtos apreendidos e distribuímos para entidades parceiras.',
    image: '/img/projeto-doacao.jpg',
  },
  {
    title: 'Palestras e Cursos',
    subtitle: 'Educação e comunidade',
    description: 'Desenvolvimento de Cursos, Palestras e Seminários com temas de interesse da sociedade e da comunidade educacional do DF e seu Entorno.',
    image: '/img/projeto-palestras.jpg',
  },
  {
    title: 'Projetos Culturais e Eventos',
    subtitle: 'Parceria com o GDF',
    description: 'Em parceria com o Governo do Distrito Federal desenvolvemos projetos culturais (exposições) e eventos festivos comemorativos.',
    image: '/img/projeto-eventos.jpg',
  },
];
---

<Layout title="Início — CEESP">
  <!-- Hero -->
  <section class="relative min-h-[88vh] flex items-center overflow-hidden">
    <img src="/img/bg.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950/90 via-navy-900/85 to-navy-800/70"></div>

    <div class="relative max-w-6xl mx-auto px-6 py-24 text-white w-full">
      <div class="flex items-center gap-3 mb-6">
        <img src="/img/logo.jpg" alt="Logo CEESP" class="w-16 h-16 rounded-full ring-2 ring-gold-400/60" />
        <div>
          <p class="uppercase tracking-widest text-gold-300 text-xs font-semibold">OSCIP</p>
          <p class="text-sm text-navy-100/90">Centro de Estudos Especiais e<br />Desenvolvimento de Projetos e Pesquisas</p>
        </div>
      </div>

      <h1 class="font-display text-4xl md:text-6xl font-bold leading-tight max-w-3xl">
        Ajudando o Brasil<br />
        <span class="text-gold-300">a crescer.</span>
      </h1>
      <p class="mt-6 text-lg md:text-xl text-navy-50/90 max-w-2xl">
        Justiça · Trabalho · Transparência · Excelência.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/contato"
          class="inline-flex items-center rounded-full bg-gold-400 text-navy-900 font-semibold px-7 py-3 hover:bg-gold-300 transition-colors"
        >
          Fale Conosco
        </a>
        <a
          href="/sobre"
          class="inline-flex items-center rounded-full border border-white/40 text-white font-semibold px-7 py-3 hover:bg-white/10 transition-colors"
        >
          Conheça o CEESP
        </a>
      </div>
    </div>
  </section>

  <!-- Histórico -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-gold-600 font-semibold text-sm uppercase tracking-widest">Quem somos</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-navy-900 mt-3">
          Breve Histórico Institucional
        </h2>
      </div>

      <div class="space-y-6 text-lg leading-relaxed text-slate-700">
        <p>
          O <strong>CEESP</strong> é uma Organização não Governamental sem fins lucrativos, de caráter
          associativo, qualificada como <strong>OSCIP — Organização da Sociedade Civil de Interesse Público</strong>.
        </p>
        <p>
          Criada em <strong>10/06/1997</strong> e registrada em <strong>13/02/1998</strong>, sempre se
          posicionou como entidade do terceiro setor a fim de facilitar o atendimento das demandas da
          sociedade, através de Projetos em parceria com o Estado.
        </p>
        <p class="text-navy-800 font-semibold text-xl pt-6 border-t border-slate-200">
          Trabalhando para um Brasil mais igualitário.
        </p>
      </div>
    </div>
  </section>

  <!-- Projetos -->
  <section class="py-20 md:py-28 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-gold-600 font-semibold text-sm uppercase tracking-widest">Nossa atuação</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-navy-900 mt-3">
          Alguns Projetos Recentes
        </h2>
        <a
          href="/docs/portfolio-ceesp.pdf"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-2 mt-4 text-slate-600 hover:text-navy-800 transition-colors"
        >
          <span class="underline decoration-gold-400 decoration-2 underline-offset-4">
            Breve descrição de alguns projetos executados e em execução.
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <article class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-navy-400 hover:shadow-xl transition-all">
            <div class="relative h-48 overflow-hidden">
              <img src={p.image} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-900/60 to-transparent"></div>
            </div>
            <div class="p-6">
              <p class="text-xs uppercase tracking-wider text-gold-600 font-semibold">{p.subtitle}</p>
              <h3 class="font-display text-xl font-bold text-navy-900 mt-1 mb-3">{p.title}</h3>
              <p class="text-slate-600 leading-relaxed text-sm">{p.description}</p>
              {p.links && (
                <ul class="mt-4 space-y-1.5">
                  {p.links.map((l) => (
                    <li>
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-1.5 text-sm font-semibold text-navy-700 hover:text-navy-900"
                      >
                        <span class="underline decoration-gold-400 decoration-2 underline-offset-4">{l.label}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Galeria / Evento -->
  <section class="py-20 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center">
      <div class="rounded-2xl overflow-hidden shadow-lg ring-1 ring-slate-200">
        <img src="/img/evento-expoestados.jpg" alt="Evento Expoestados é Show — realização CEESP" class="w-full h-full object-cover" />
      </div>
      <div>
        <p class="text-gold-600 font-semibold text-sm uppercase tracking-widest">Realizações</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-navy-900 mt-3">
          Eventos e parcerias institucionais
        </h2>
        <p class="text-slate-600 mt-5 leading-relaxed">
          O CEESP realiza eventos culturais em parceria com instituições como
          <strong>Setor</strong>, <strong>IPHAN</strong>, <strong>Secretaria de Turismo</strong> e o
          <strong>Governo do Distrito Federal</strong>, promovendo cultura, inclusão e valorização
          das identidades locais.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {['Setor', 'IPHAN', 'Sec. Turismo', 'GDF'].map((s) => (
            <span class="inline-flex items-center rounded-full border border-navy-200 bg-navy-50 text-navy-800 text-xs font-semibold px-3 py-1">
              {s}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Transparência -->
  <section class="py-20 md:py-24 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-gold-600 font-semibold text-sm uppercase tracking-widest">Transparência</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-navy-900 mt-3">
          Documentos Institucionais
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {[
          {
            title: 'Termo de Fomento 81/2022',
            description: 'Documento de transparência — Termo de Fomento 81/2022.',
            href: '/docs/termo-fomento-81-2022-transparencia.pdf',
          },
          {
            title: 'Termo de Fomento 81/2022 — Completo',
            description: 'Termo de Fomento 81/2022 completo — Projeto Quintal do Samba 2022 (SEI/GDF 101021960 — MROSC).',
            href: '/docs/termo-fomento-81-2022-quintal-samba.pdf',
          },
          {
            title: 'Portfólio Institucional',
            description: 'Portfólio institucional do CEESP — conheça nossa entidade.',
            href: '/docs/portfolio-institucional.pdf',
          },
        ].map((d) => (
          <a
            href={d.href}
            target="_blank"
            rel="noopener"
            class="group rounded-2xl border border-gold-200 bg-gradient-to-br from-gold-50 via-white to-navy-50 p-8 hover:border-gold-400 hover:shadow-xl transition-all flex flex-col"
          >
            <div class="flex items-start justify-between gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400 group-hover:text-navy-700 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
            <h3 class="font-display text-lg font-bold text-navy-900 mt-6">{d.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed mt-2 flex-1">{d.description}</p>
            <span class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-navy-700">
              Abrir PDF
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-navy-900 text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold">Vamos conversar?</h2>
      <p class="mt-4 text-navy-100 text-lg">
        Estamos à disposição para parcerias, projetos e colaborações.
      </p>
      <a
        href="/contato"
        class="mt-8 inline-flex items-center rounded-full bg-gold-400 text-navy-900 font-semibold px-8 py-3 hover:bg-gold-300 transition-colors"
      >
        Entre em contato
      </a>
    </div>
  </section>
</Layout>
