---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/contato', label: 'Contato' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 font-display font-bold text-navy-800 tracking-tight">
      <img src="/img/logo.jpg" alt="CEESP" class="w-11 h-11 rounded-full object-cover ring-1 ring-navy-100" />
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="text-lg text-navy-800">CEESP</span>
        <span class="text-[10px] font-medium text-navy-500 uppercase tracking-wider">OSCIP</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {links.map((l) => (
        <a
          href={l.href}
          class={`text-sm font-medium transition-colors hover:text-navy-600 ${
            pathname === l.href ? 'text-navy-700' : 'text-slate-600'
          }`}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <button id="menu-btn" class="md:hidden p-2 text-slate-700" aria-label="Abrir menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white">
    <nav class="px-6 py-4 flex flex-col gap-3">
      {links.map((l) => (
        <a href={l.href} class="text-slate-700 font-medium py-1">{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
